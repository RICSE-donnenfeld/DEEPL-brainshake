%% CNN pipeline — horizontal
flowchart LR
    data["CHB-MIT EEG [N, 21, 128]"] --> kfold["5-fold<br/>patient CV"]
    kfold --> loader["DataLoader<br/>batch=32"]
    loader --> cnn["Conv1d×3 blocks<br/>21→32→64→128<br/>+BN+ReLU+MaxPool"]
    cnn --> fc["FC: 2048→256<br/>Drop0.3→2"]
    fc --> train["Adam(lr=1e-3)<br/>CE(class-wtd)<br/>2 epochs"]
    train --> evaluate["Per-fold metrics"]

